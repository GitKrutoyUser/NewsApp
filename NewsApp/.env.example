# Скопируйте этот файл в .env и укажите свой ключ
FREENEWSAPI_API_KEY=общий_резервный_ключ
FREENEWSAPI_BASE_URL=https://freenewsapi.ai
FREENEWSAPI_SEARCH_PATH=/v1/search
FREENEWSAPI_ARTICLE_PATH=/v1/article
FREENEWSAPI_LANG=ru,en
FREENEWSAPI_RU_API_KEY=ключ_для_русских_новостей
FREENEWSAPI_EN_API_KEY=ключ_для_английских_новостей

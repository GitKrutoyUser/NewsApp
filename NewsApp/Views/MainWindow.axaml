<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NewsApp.ViewModels"
        xmlns:models="using:NewsApp.Models"
        xmlns:controls="using:NewsApp.Controls"
        x:Class="NewsApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1440" Height="880" MinWidth="1100" MinHeight="680"
        Background="#0D1117" Title="Глобус с новостями">
  <Window.Styles>
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#F4F7FB"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#8B98A9"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="Button.country"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="0,2"/></Style>
    <Style Selector="Button.country:pointerover"><Setter Property="Background" Value="#1B2634"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#151D28"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
    <Style Selector="Button.link"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#72B7FF"/><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="Button.articleTitle"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="PathIcon.icon"><Setter Property="Foreground" Value="#F6FAFF"/></Style>
  </Window.Styles>
  <Grid>
  <Grid ColumnDefinitions="390,*" ColumnSpacing="26">
    <Border Grid.Column="0" Background="#111821" Padding="18" CornerRadius="0,18,18,0">
      <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
        <StackPanel Spacing="6">
        </StackPanel>
        <controls:GlobeControl x:Name="Globe" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" MinHeight="350"/>
        <TextBlock Grid.Row="2" Text="{Binding SelectedCountry.DisplayName}" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="#F4F7FB" Margin="0,10,0,2"/>
        <Button x:Name="AutoRotationButton" Grid.Row="3" ToolTip.Tip="Автоповорот глобуса" Click="OnAutoRotationClick" HorizontalAlignment="Center" Padding="14,8" Margin="0,8,0,4" Background="#1B4F7A" Foreground="White" CornerRadius="7">
          <PathIcon Classes="icon" Data="M 7,4 L 7,20 L 20,12 Z" Width="18" Height="18"/>
        </Button>
        <TextBlock Grid.Row="4" Text="Перетаскивание — вручную, колесо — масштаб" Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="10,30,38,20">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="{Binding SelectedCountry.DisplayName}" Classes="title"/>
            <TextBlock Text="{Binding SelectedCountry.NewNewsMarker}" Foreground="#FFCA4B" FontSize="24" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Свежие события из локального кэша WorldPulse" Classes="muted" Margin="0,6,0,0"/>
        </StackPanel>
        <Button Grid.Column="1" Padding="15,9" ToolTip.Tip="Выбрать способ обновления" Background="#2477D4" Foreground="White" CornerRadius="8" IsEnabled="{Binding !IsRefreshing}">
          <PathIcon Classes="icon" Data="M 20,11 A 8.1,8.1 0 0 0 4.5,9 M 4,5 L 4,9 L 8,9 M 4,13 A 8.1,8.1 0 0 0 19.5,15 M 20,19 L 20,15 L 16,15" Width="20" Height="20"/>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Показать из базы" Command="{Binding LoadCacheCommand}"/>
              <MenuItem Header="Обновить через API" Command="{Binding RefreshCommand}"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
      <TextBlock Grid.Row="1" Text="{Binding StatusText}" Classes="muted" Margin="0,22,0,16"/>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsReadingArticle}">
        <ItemsControl ItemsSource="{Binding Articles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:NewsArticle">
              <Border Classes="card">
                <Grid ColumnDefinitions="*,190" ColumnSpacing="20">
                  <StackPanel Spacing="9">
                    <TextBlock Text="{Binding CountryName}" Foreground="#72B7FF" FontSize="12" FontWeight="Bold"/>
                    <Button Classes="articleTitle" Command="{Binding $parent[Window].DataContext.OpenArticleCommand}" CommandParameter="{Binding}">
                      <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Button>
                    <TextBlock Text="{Binding Description}" Classes="muted" FontSize="14" TextWrapping="Wrap"/>
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Опубликовано:" Classes="muted"/>
                        <TextBlock Text="{Binding PublishedAtText}" Classes="muted"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="14">
                        <Button Content="Читать в приложении →" Classes="link" Command="{Binding $parent[Window].DataContext.OpenArticleCommand}" CommandParameter="{Binding}"/>
                        <Button Content="Читать на сайте ↗" Classes="link" Command="{Binding $parent[Window].DataContext.OpenArticleInBrowserCommand}" CommandParameter="{Binding}"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                  <Border Grid.Column="1" Background="#202B39" CornerRadius="10" ClipToBounds="True">
                    <Image Source="{Binding ImageBitmap}" Stretch="Uniform" Width="190" MaxHeight="180" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Grid Grid.Row="2" IsVisible="{Binding IsReadingArticle}" ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <StackPanel Spacing="10" VerticalAlignment="Top">
          <Button ToolTip.Tip="Назад к новостям" Command="{Binding CloseArticleCommand}" Padding="12,9">
            <PathIcon Classes="icon" Data="M 5,12 L 19,12 M 5,12 L 11,18 M 5,12 L 11,6" Width="20" Height="20"/>
          </Button>
          <Button ToolTip.Tip="В начало статьи" Click="OnArticleScrollToTop" Padding="12,9">
            <PathIcon Classes="icon" Data="M 12,5 L 12,19 M 18,11 L 12,5 L 6,11" Width="20" Height="20"/>
          </Button>
        </StackPanel>
        <ScrollViewer x:Name="ArticleScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto">
          <Border Background="#111A25" CornerRadius="16" Padding="28" HorizontalAlignment="Center" MaxWidth="900">
            <StackPanel Spacing="18">
            <Border Background="#182536" CornerRadius="12" Padding="20">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding OpenedArticle.CountryName}" Foreground="#72B7FF" FontSize="13" FontWeight="Bold"/>
                <TextBlock Text="{Binding OpenedArticle.Title}" FontSize="30" FontWeight="Bold" Foreground="#F7FAFD" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{Binding OpenedArticle.PublishedAtText}" Classes="muted"/>
                  <TextBlock Text="•" Classes="muted"/>
                  <TextBlock Text="Встроенное чтение" Classes="muted"/>
                  <Button Classes="link" Command="{Binding OpenArticleInBrowserCommand}" CommandParameter="{Binding OpenedArticle}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="Открыть на сайте"/>
                      <PathIcon Classes="icon" Data="M 6,6 L 6,18 L 18,18 L 18,12 M 11,13 L 20,4 M 15,4 L 20,4 L 20,9" Width="15" Height="15"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
            <Image Source="{Binding OpenedArticle.ImageBitmap}" MaxHeight="360" Stretch="Uniform" HorizontalAlignment="Center"/>
            <TextBlock Text="Загрузка материалов статьи…" Classes="muted" IsVisible="{Binding IsArticleLoading}"/>
            <ItemsControl ItemsSource="{Binding OpenedArticleParagraphs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontSize="17" LineHeight="29" Foreground="#D8E1EB" TextWrapping="Wrap" Margin="0,0,0,12"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          </Border>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
  <Border IsVisible="{Binding IsLoading}" Background="#050A10" ZIndex="20">
    <Border Background="#0B1824" CornerRadius="200" Padding="4" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 8 30 0 #88000000">
      <controls:GlobeControl x:Name="LoadingGlobe" Width="330" Height="330" IsHitTestVisible="False"/>
    </Border>
  </Border>
  </Grid>
</Window>

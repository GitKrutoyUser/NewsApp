<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NewsApp.ViewModels"
        xmlns:models="using:NewsApp.Models"
        xmlns:controls="using:NewsApp.Controls"
        x:Class="NewsApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        KeyDown="OnWindowKeyDown"
        Width="1440" Height="880" MinWidth="1100" MinHeight="680"
        Background="#03060D" Title="Глобус с новостями">
  <Window.Styles>
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#F7FAFF"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#A8B8CC"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="Button.country"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="0,2"/></Style>
    <Style Selector="Button.country:pointerover"><Setter Property="Background" Value="#442D5C82"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#B8141E2D"/><Setter Property="BorderBrush" Value="#665F82A2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="16,16,16,10"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="BoxShadow" Value="0 6 18 0 #33000000"/></Style>
    <Style Selector="Border.card:pointerover"><Setter Property="Background" Value="#CC19283A"/><Setter Property="BorderBrush" Value="#AA83C9F5"/></Style>
    <Style Selector="Button.link"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#8ECFFF"/><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="Button.articleTitle"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="TextBlock.toolbarIcon"><Setter Property="Foreground" Value="#F6FAFF"/><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Border.newsPanel"><Setter Property="Background" Value="#D90B1422"/><Setter Property="BorderBrush" Value="#805E7898"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="24,0,0,24"/><Setter Property="BoxShadow" Value="-12 0 32 0 #66000000"/></Style>
    <Style Selector="Button.panelHandle"><Setter Property="Background" Value="#B51A2B43"/><Setter Property="BorderBrush" Value="#886A9CC0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#EAF5FF"/><Setter Property="Padding" Value="7,16"/><Setter Property="Height" Value="58"/><Setter Property="Width" Value="52"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.panelHandle:pointerover"><Setter Property="Background" Value="#DD2A5B85"/><Setter Property="BorderBrush" Value="#CC9EDBFF"/></Style>
    <Style Selector="Button.refreshMain"><Setter Property="Background" Value="#C4141D2A"/><Setter Property="BorderBrush" Value="#99677D96"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#F1F7FF"/><Setter Property="Height" Value="46"/><Setter Property="Width" Value="54"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="11,0,0,11"/></Style>
    <Style Selector="Button.refreshMain:pointerover"><Setter Property="Background" Value="#DD26384D"/><Setter Property="BorderBrush" Value="#CCB3D8F2"/></Style>
    <Style Selector="Button.refreshMore"><Setter Property="Background" Value="#B4141D2A"/><Setter Property="BorderBrush" Value="#99677D96"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#C7D8E8"/><Setter Property="Height" Value="46"/><Setter Property="Width" Value="34"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="0,11,11,0"/></Style>
    <Style Selector="Button.refreshMore:pointerover"><Setter Property="Background" Value="#DD26384D"/><Setter Property="BorderBrush" Value="#CCB3D8F2"/></Style>
    <Style Selector="Button.articleNav"><Setter Property="Background" Value="#B5121927"/><Setter Property="BorderBrush" Value="#99677D96"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Width" Value="52"/><Setter Property="Height" Value="52"/><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="Button.articleNav:pointerover"><Setter Property="Background" Value="#DD26384D"/><Setter Property="BorderBrush" Value="#CCB3D8F2"/></Style>
    <Style Selector="TextBox.newsSearch"><Setter Property="Background" Value="#99111D2B"/><Setter Property="Foreground" Value="#F1F7FF"/><Setter Property="BorderBrush" Value="#806A8EAB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12,7"/><Setter Property="WatermarkForeground" Value="#8EA3B8"/></Style>
  </Window.Styles>
  <Grid x:Name="MainLayout">
    <controls:StarfieldControl/>
    <controls:GlobeControl x:Name="Globe" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="18"/>

    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="28,0,0,28" Background="#99101929" BorderBrush="#665D7896" BorderThickness="1" CornerRadius="18" Padding="16,10" BoxShadow="0 8 22 0 #44000000">
      <StackPanel Spacing="7">
        <TextBlock Text="{Binding SelectedCountry.DisplayName}" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#F4F7FB"/>
          <Button x:Name="AutoRotationButton" ToolTip.Tip="Автоповорот глобуса" Click="OnAutoRotationClick" HorizontalAlignment="Center" Padding="14,8" Background="#C41B4F7A" BorderBrush="#887FBEE8" BorderThickness="1" Foreground="White" CornerRadius="9">
          <PathIcon Data="M 7,5 L 18,12 L 7,19 Z" Width="20" Height="20" Foreground="#F6FAFF"/>
        </Button>
      </StackPanel>
    </Border>

    <Border x:Name="NewsPanel" Classes="newsPanel" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,20,24,20" Width="720">
      <Grid ColumnDefinitions="Auto,*">
        <Button x:Name="NewsPaneToggleButton" Grid.Column="0" Classes="panelHandle" Command="{Binding ToggleNewsPaneCommand}" ToolTip.Tip="Показать или скрыть новости" CornerRadius="10" Margin="-1,0,10,0">
          <PathIcon Data="M 17,4 L 9,12 L 17,20 L 14,23 L 3,12 L 14,1 Z" Width="20" Height="20" Foreground="#EAF5FF"/>
        </Button>
        <Grid x:Name="NewsContent" Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="0,12,12,12" IsVisible="False" Opacity="1">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBox Classes="newsSearch" Width="260" PlaceholderText="Поиск по новостям" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="{Binding SelectedCountry.DisplayName}" Classes="title"/>
                <TextBlock Text="{Binding SelectedCountry.NewNewsMarker}" Foreground="#FFCA4B" FontSize="24" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="Последние новости" Classes="muted" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Top">
              <Button Content="Фильтры" Margin="0,0,8,0" Padding="12,8" Background="#B4141D2A" BorderBrush="#99677D96" BorderThickness="1" Foreground="#DCEBFA" CornerRadius="9" ToolTip.Tip="Фильтры новостей">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <Border Background="#F21A2838" BorderBrush="#AA7895B4" BorderThickness="1" CornerRadius="16" Padding="16" Width="280" BoxShadow="0 12 30 0 #99000000">
                      <StackPanel Spacing="9">
                        <TextBlock Text="Фильтры новостей" FontSize="18" FontWeight="Bold" Foreground="#F4F8FF"/>
                        <TextBlock Text="{Binding FilterSummary}" Classes="muted"/>
                        <TextBlock Text="Язык" Foreground="#8BC7FF" FontWeight="Bold" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Button Content="Все" Command="{Binding SetLanguageFilterCommand}" CommandParameter="all" Padding="10,6"/>
                          <Button Content="Русский" Command="{Binding SetLanguageFilterCommand}" CommandParameter="ru" Padding="10,6"/>
                          <Button Content="English" Command="{Binding SetLanguageFilterCommand}" CommandParameter="en" Padding="10,6"/>
                        </StackPanel>
                        <TextBlock Text="Период публикации" Foreground="#8BC7FF" FontWeight="Bold" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Button Content="Всё" Command="{Binding SetPeriodFilterCommand}" CommandParameter="0" Padding="10,6"/>
                          <Button Content="24 часа" Command="{Binding SetPeriodFilterCommand}" CommandParameter="1" Padding="10,6"/>
                          <Button Content="7 дней" Command="{Binding SetPeriodFilterCommand}" CommandParameter="7" Padding="10,6"/>
                        </StackPanel>
                        <Button Content="Только с изображениями" Command="{Binding ToggleImagesFilterCommand}" HorizontalContentAlignment="Left" Padding="10,7"/>
                        <Button Content="Сбросить фильтры" Command="{Binding ResetFiltersCommand}" HorizontalContentAlignment="Center" Padding="10,8" Background="#883B5E7D" Foreground="#FFFFFF"/>
                      </StackPanel>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button x:Name="RefreshButton" Classes="refreshMain" Command="{Binding RefreshCommand}" ToolTip.Tip="Обновить через API" CornerRadius="9,0,0,9" IsEnabled="{Binding !IsRefreshing}">
                <Path x:Name="RefreshIcon" Data="M 19,9 C 16,3 8,3 5,9 M 5,9 V 4 M 5,9 H 10 M 5,15 C 8,21 16,21 19,15 M 19,15 V 20 M 19,15 H 14" Width="25" Height="25" Stretch="Uniform" Stroke="#F1F7FF" StrokeThickness="2.2" StrokeLineCap="Round"/>
              </Button>
              <Button Classes="refreshMore" ToolTip.Tip="Выбрать способ обновления" CornerRadius="0,9,9,0" IsEnabled="{Binding !IsRefreshing}">
                <Path Data="M 7,9 L 12,14 L 17,9" Width="15" Height="15" Stretch="Uniform" Stroke="#C7D8E8" StrokeThickness="2" StrokeLineCap="Round"/>
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="Показать из базы" Command="{Binding LoadCacheCommand}"/>
                    <MenuItem Header="Обновить через API" Command="{Binding RefreshCommand}"/>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding StatusText}" Classes="muted" Margin="0,22,0,16"/>
          <ScrollViewer x:Name="NewsScrollViewer" Grid.Row="2" ScrollChanged="OnNewsScrollChanged" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" IsVisible="{Binding !IsReadingArticle}">
            <StackPanel>
            <ItemsControl ItemsSource="{Binding Articles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:NewsArticle">
                  <Border Classes="card" VerticalAlignment="Top">
                    <Grid ColumnDefinitions="*,190" ColumnSpacing="20" VerticalAlignment="Top">
                      <StackPanel Spacing="9" VerticalAlignment="Top">
                        <TextBlock Text="{Binding CountryName}" Foreground="#8BC7FF" FontSize="12" FontWeight="Bold"/>
                        <Button Classes="articleTitle" Command="{Binding $parent[Window].DataContext.OpenArticleCommand}" CommandParameter="{Binding}">
                          <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Button>
                        <TextBlock Text="{Binding Description}" Classes="muted" FontSize="14" TextWrapping="Wrap"/>
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                          <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="Опубликовано:" Classes="muted"/><TextBlock Text="{Binding PublishedAtText}" Classes="muted"/></StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="14"><Button Content="Читать в приложении →" Classes="link" Command="{Binding $parent[Window].DataContext.OpenArticleCommand}" CommandParameter="{Binding}"/><Button Content="Читать на сайте ↗" Classes="link" Command="{Binding $parent[Window].DataContext.OpenArticleInBrowserCommand}" CommandParameter="{Binding}"/></StackPanel>
                        </StackPanel>
                      </StackPanel>
                      <Border Grid.Column="1" Background="#44101A25" BorderBrush="#AA6887A5" BorderThickness="1" CornerRadius="12" ClipToBounds="True" VerticalAlignment="Top">
                        <Grid Width="190" Height="140">
                          <Image Source="{Binding ImageBitmap}" IsVisible="{Binding HasImage}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                          <Image Source="avares://NewsApp/Assets/news-placeholder.png" IsVisible="{Binding !HasImage}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.92"/>
                        </Grid>
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Загрузка следующих новостей…" Classes="muted" HorizontalAlignment="Center" Margin="0,10" IsVisible="{Binding IsLoadingMore}"/>
            </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="2" IsVisible="{Binding IsReadingArticle}" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
              <Button Classes="articleNav" ToolTip.Tip="Назад к новостям" Command="{Binding CloseArticleCommand}"><Path Data="M 20,13 H 5 M 5,13 L 12,6 M 5,13 L 12,20" Width="28" Height="28" Stretch="Uniform" Stroke="#F1F7FF" StrokeThickness="4.5" StrokeLineCap="Round"/></Button>
              <Button Classes="articleNav" ToolTip.Tip="В начало статьи" Click="OnArticleScrollToTop"><Path Data="M 11,20 V 5 M 11,5 L 4,12 M 11,5 L 18,12" Width="28" Height="28" Stretch="Uniform" Stroke="#F1F7FF" StrokeThickness="4.5" StrokeLineCap="Round"/></Button>
            </StackPanel>
            <ScrollViewer x:Name="ArticleScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto">
              <Border Background="#D90E1827" BorderBrush="#806482A0" BorderThickness="1" CornerRadius="20" Padding="28" HorizontalAlignment="Center" MaxWidth="900" BoxShadow="0 12 36 0 #88000000">
                <StackPanel Spacing="18">
                  <Border Background="#C91A293B" BorderBrush="#8A789AB6" BorderThickness="1" CornerRadius="16" Padding="22"><StackPanel Spacing="12"><TextBlock Text="{Binding OpenedArticle.CountryName}" Foreground="#9AD4FF" FontSize="13" FontWeight="Bold"/><TextBlock Text="{Binding OpenedArticle.Title}" FontSize="30" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap"/><Border Background="#7A0D1624" BorderBrush="#556D89A5" BorderThickness="1" CornerRadius="10" Padding="13,10"><TextBlock Text="{Binding OpenedArticle.Description}" FontSize="16" FontWeight="SemiBold" Foreground="#DCEBFA" TextWrapping="Wrap"/></Border><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding OpenedArticle.PublishedAtText}" Classes="muted"/><TextBlock Text="•" Classes="muted"/><TextBlock Text="Полная выбранная новость" Classes="muted"/><Button Classes="link" Command="{Binding OpenArticleInBrowserCommand}" CommandParameter="{Binding OpenedArticle}"><TextBlock Text="Открыть на сайте ↗"/></Button></StackPanel></StackPanel></Border>
                  <Border Background="#66101A25" BorderBrush="#665F82A2" BorderThickness="1" CornerRadius="16" Padding="8" IsVisible="{Binding OpenedArticle.HasImage}"><Image Source="{Binding OpenedArticle.ImageBitmap}" MaxHeight="360" Stretch="Uniform" HorizontalAlignment="Center"/></Border>
                  <TextBlock Text="Загрузка материалов статьи…" Classes="muted" IsVisible="{Binding IsArticleLoading}"/>
                  <Border Background="#66101A25" BorderBrush="#665F82A2" BorderThickness="1" CornerRadius="14" Padding="18"><StackPanel Spacing="14"><TextBlock Text="Полный текст этой новости" FontSize="18" FontWeight="Bold" Foreground="#B9DFFF"/><ItemsControl ItemsSource="{Binding OpenedArticleParagraphs}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="17" LineHeight="29" Foreground="#D8E1EB" TextWrapping="Wrap" Margin="0,0,0,12"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                </StackPanel>
              </Border>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <Border IsVisible="{Binding IsLoading}" Background="#050A10" ZIndex="20">
      <Border Background="#0B1824" CornerRadius="200" Padding="4" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 8 30 0 #88000000"><controls:GlobeControl x:Name="LoadingGlobe" Width="330" Height="330" IsHitTestVisible="False"/></Border>
    </Border>
  </Grid>
</Window>
